# 复制成 .env 后按需修改。默认值（MODEL_MODE=echo）下不配任何东西也能跑通全链路。
#
# ⚠️ 这个文件里的值是**默认值**，不是唯一改法。
#    模型接入与角色卡都能在应用内改：打开 http://127.0.0.1:8787/settings
#    应用内改的值存在数据库里，**优先于本文件**，且保存即生效、不用重启。
#    下面标了「可在应用内改」的项，改 .env 只是给"没在界面上配过的用户"兜底。

PORT=8787

# 角色设定（可在应用内改 → 设置页「角色卡」与「她眼中的你」）
# 这里只是一个初始值；应用里改了之后以应用里的为准。
CHARACTER_NAME=小茉
OWNER_NAME=他

# 模型（可全部在应用内改 → 设置页「接入模型」）
# echo = 本地假回复（不花钱、不依赖网络）；openai = 调真实模型（任何 OpenAI 兼容服务）
MODEL_MODE=echo
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# 必填提醒：模型名必须是该服务商「实际有可用渠道」的名字。
# 有的服务商对不存在的模型不报错、而是让请求挂住直到超时（表现为 "This operation was aborted"）。
# 拿不准就在设置页点「测试连接」，或跑 `npm run doctor`——两者都会列出可用模型并逐个实测。
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_MS=90000
# 供应商专属参数，JSON 形式直接合并进请求体（用不到就留空）
# 例：{"thinking":{"type":"disabled"}} 或 {"enable_search":true}
MODEL_EXTRA_BODY=
# 启动时自检模型是否可用（只在控制台告警，不阻止启动）
MODEL_STARTUP_CHECK=true

# 主动性
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MINUTES=30
PROACTIVE_IDLE_MINUTES=120
# 免打扰时段（小时，跨零点用 start>end 表示），此时段内不主动打扰
QUIET_HOURS=23-8
# 每联系人每天主动发言的默认上限（联系人资料页可按人覆盖，1~10）
PROACTIVE_DAILY_LIMIT=1

# 记忆整理（合并重复/标过期/刷新生活线与温度计）的最小间隔天数；0 = 关闭后台整理。
# 开关在「编辑资料 → 陪伴能力」按联系人自主决定，这里是全局节奏。
CONSOLIDATE_INTERVAL_DAYS=7

# 上下文与记忆
# 回放最近多少【轮】对话给模型（一问一答算一轮；超出靠记忆层，不靠翻旧消息）
RECENT_TURNS_IN_CONTEXT=6
RECALL_LIMIT=6

# 数据文件
DB_PATH=./data/xiaomo.db
# 图片附件目录（留空 = 库文件同级的 media/）。测试实例可指到别处，避免写生产目录。
MEDIA_DIR=
# 开发模式：置 1 后调用记录会连「请求原文」一起给界面看（默认只给响应全文）。
# 生产别开——请求原文里含系统提示词与内联图片。
DEV_MODE=
# 相对路径统一按此目录解析（桌面端外壳注入；留空 = 相对运行目录）
DATA_DIR=
# 端口握手文件路径（桌面端外壳注入，sidecar 写实际端口）
RUNTIME_FILE=

# 监听地址：默认只绑本机（密钥与聊天记录都在这台机器上）。
# 手机要局域网访问时显式改成 0.0.0.0，并自行理解暴露风险。
HOST=127.0.0.1

# 公网穿透（cloudflared 等）可信主机名，逗号分隔、大小写不敏感。隧道会把公网域名原样
# 当 Host 转发进来，不写进这里就会被本机守卫按「外来域名」拒掉（403）。留空 = 不信任任何
# 外部域名。示例：TRUSTED_HOSTS=xiaomo.example.com,another.example.com
TRUSTED_HOSTS=
