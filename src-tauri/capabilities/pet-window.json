{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet-window",
  "description": "桌宠透明窗口：只开 core 默认能力，用于调用桌宠控制命令与读取本机设置。",
  "windows": [
    "pet"
  ],
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "core:default",
    "allow-pet-window-show",
    "allow-pet-window-hide",
    "allow-pet-window-move",
    "allow-pet-window-resize",
    "allow-pet-window-set-always-on-top",
    "allow-pet-window-set-hit",
    "allow-pet-window-show-main"
  ]
}
